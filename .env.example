# 模型配置：复制本文件为 .env 并填入值（.env 已被 .gitignore 排除，不要提交）

# 方式一：真实模型。按「提供商:模型名」格式，例如：
#   AGENT_MODEL=openai:gpt-5.5
#   AGENT_MODEL=deepseek:deepseek-v4.1-flash
AGENT_MODEL=

# 对应提供商的 API key（langchain-openai 等接入包会自动读取）
OPENAI_API_KEY=

# 方式二：API易 统一网关（本系列测试验证用）
YI_API_KEY=
YI_BASE_URL=

# 测试用模型名称：
#   文本模型：deepseek-v4.1-flash
#   图片模型：gpt-image-2
#   嵌入模型：qwen3-vl-embedding
YI_IMAGE_MODEL=
